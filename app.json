{
  "expo": {
    "name": "Tsena",
    "slug": "tsena-market",
    "version": "0.3.0",
    "orientation": "portrait",
    "scheme": "tsena",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1120"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mg.adhstudio.tsena"
    },
    "android": {
      "package": "mg.adhstudio.tsena",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1120"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        { "fonts": [] }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
